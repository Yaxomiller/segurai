# Keep the image small and free of anything private: only pyproject.toml,
# README.md, LICENSE and src/ are copied in by the Dockerfile.
.git
.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
build
dist
*.egg-info
tests
evals
examples
docs
deploy

# Never ship data or keys inside an image.
*.db
*.db-*
*.key
*.pub
